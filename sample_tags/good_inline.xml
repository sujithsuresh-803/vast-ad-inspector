<?xml version="1.0" encoding="UTF-8"?>
<!-- SAMPLE / SYNTHETIC VAST 4.2 InLine tag (illustrative, not a live ad). Structure per IAB VAST spec. -->
<VAST version="4.2">
  <Ad id="clean-linear-001">
    <InLine>
      <AdSystem version="1.0">Google Ad Manager</AdSystem>
      <AdTitle>Sample Video Ad — Clean Integration</AdTitle>
      <Impression><![CDATA[https://example-adserver.test/imp?id=clean-001]]></Impression>
      <Error><![CDATA[https://example-adserver.test/error?code=[ERRORCODE]]]></Error>
      <AdVerifications>
        <Verification vendor="omid.google.com">
          <JavaScriptResource apiFramework="omid" browserOptional="true"><![CDATA[https://example.test/omid.js]]></JavaScriptResource>
        </Verification>
      </AdVerifications>
      <Creatives>
        <Creative id="1" sequence="1">
          <Linear skipoffset="00:00:05">
