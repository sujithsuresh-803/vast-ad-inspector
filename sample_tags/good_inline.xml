              <Tracking event="firstQuartile"><![CDATA[https://example.test/t?e=q1]]></Tracking>
              <Tracking event="midpoint"><![CDATA[https://example.test/t?e=mid]]></Tracking>
              <Tracking event="thirdQuartile"><![CDATA[https://example.test/t?e=q3]]></Tracking>
              <Tracking event="complete"><![CDATA[https://example.test/t?e=complete]]></Tracking>
            </TrackingEvents>
            <VideoClicks>
              <ClickThrough><![CDATA[https://advertiser.example/landing]]></ClickThrough>
            </VideoClicks>
            <MediaFiles>
              <MediaFile delivery="progressive" type="video/mp4" width="1280" height="720" bitrate="2000"><![CDATA[https://cdn.example.test/hi.mp4]]></MediaFile>
              <MediaFile delivery="progressive" type="video/mp4" width="854" height="480" bitrate="900"><![CDATA[https://cdn.example.test/mid.mp4]]></MediaFile>
              <MediaFile delivery="progressive" type="video/webm" width="640" height="360" bitrate="500"><![CDATA[https://cdn.example.test/lo.webm]]></MediaFile>
            </MediaFiles>
          </Linear>
        </Creative>
      </Creatives>
    </InLine>
  </Ad>
</VAST>
